rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // STEP 5 OF THE GUIDE: put your Google email (and Peter's dad's, if he wants access) here.
    function isParent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['your.email@gmail.com', 'peters.dad@gmail.com'];
    }

    // Each person's progress: they write their own; parents can read everyone's.
    match /players/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isParent());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Question packs: anyone signed in can read; only parents can add or change them.
    match /content/{id} {
      allow read: if request.auth != null;
      allow write: if isParent();
    }
  }
}
